# Dinootoo - API IA interne Orange Cyberdefense
DINOOTOO_API_KEY=your_api_key_here
DINOOTOO_BASE_URL=https://your-dinootoo-endpoint/v1
DINOOTOO_MODEL=gpt-4o
DINOOTOO_EMBEDDING_MODEL=text-embedding-3-small

# Embeddings (si Dinootoo ne supporte pas les embeddings, mettre USE_LOCAL_EMBEDDINGS=true)
USE_LOCAL_EMBEDDINGS=false
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# LangSmith (optionnel - pour le tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_key
LANGCHAIN_PROJECT=pres-factory

# Qualité - score minimum pour passer au garde-fou humain (sinon retry auto)
QUALITY_THRESHOLD=70
MAX_ITERATIONS=3
